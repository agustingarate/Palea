{
  "expo": {
    "name": "Palea",
    "slug": "palea",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "palea",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
