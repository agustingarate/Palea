{
  "extends": "@palea/typescript-config/react.json",
  "compilerOptions": {
    "allowJs": true,
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["jest", "nativewind/types"],
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
