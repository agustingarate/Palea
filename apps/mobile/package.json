{
  "name": "@palea/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "pnpm --filter @palea/design-tokens build",
    "start": "expo start",
    "start:local": "expo start --dev-client",
    "start:staging": "eas env:exec preview \"expo start --dev-client\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:staging": "eas env:exec preview \"expo start --web\"",
    "build": "expo export --platform web",
    "build:staging": "eas env:exec preview \"expo export --platform web\"",
    "build:production": "eas env:exec production \"expo export --platform web\"",
    "export:all": "expo export --platform android && expo export --platform ios && expo export --platform web",
    "lint": "eslint src",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@expo-google-fonts/inter": "^0.4.1",
    "@palea/api-client": "workspace:*",
    "@palea/contracts": "workspace:*",
    "@palea/design-tokens": "workspace:*",
    "@palea/http-client": "workspace:*",
    "@palea/localization": "workspace:*",
    "@palea/ui-native": "workspace:*",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-store": "0.11.1",
    "connect": "3.7.0",
    "decode-uri-component": "0.2.2",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.0",
    "expo-linking": "~8.0.0",
    "expo-localization": "~17.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.0",
    "expo-web-browser": "~15.0.11",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^25.6.2",
    "lucide-react-native": "1.28.0",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.0.1",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "shallowequal": "1.1.0",
    "zod": "catalog:",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@palea/eslint-config": "workspace:*",
    "@palea/typescript-config": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.11",
    "babel-preset-expo": "~54.0.0",
    "expo-doctor": "^1.17.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "tailwindcss": "3.4.17"
  }
