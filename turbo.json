{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "EXPO_PUBLIC_PALEA_ENV",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_PROJECTS_SOURCE",
    "NEXT_PUBLIC_PALEA_ENV",
    "NEXT_PUBLIC_API_URL",
    "PALEA_ENV",
    "PORT",
    "CORS_ORIGINS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
