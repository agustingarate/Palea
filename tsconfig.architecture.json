{
  "extends": "./packages/typescript-config/react.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["apps/mobile/src/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
