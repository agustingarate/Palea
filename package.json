{
  "name": "palea",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "architecture:check": "depcruise --config dependency-cruiser.cjs apps packages --output-type err",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm architecture:check && pnpm typecheck && pnpm test && pnpm build",
    "mobile": "pnpm --filter \"@palea/mobile^...\" build && pnpm --filter @palea/mobile start",
    "web": "pnpm --filter @palea/web dev",
    "backend": "pnpm --filter @palea/backend dev"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "ts-jest": "^29.4.1",
    "tsup": "^8.5.0",
    "turbo": "^2.5.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
